# Review Manager configuration. Copy to .env for local use; on Render set these as
# environment variables. Every variable the app reads is listed here, with its default.
# Blank or commented = the default in brackets applies.

# ---- Database -------------------------------------------------------------
# Local dev: SQLite file. Production: Postgres. Paste the provider's URL as given:
# postgres:// and postgresql:// are rewritten to the installed psycopg 3 driver.
DATABASE_URL=sqlite:///./review_manager.db

# ---- Web app --------------------------------------------------------------
# Required off localhost: at least 24 random characters. The app refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Public address, used in email links. On Render RENDER_EXTERNAL_URL is used when this is blank.
APP_BASE_URL=http://localhost:8000
TIMEZONE=America/Chicago
# DEBUG / INFO / WARNING [INFO]
# LOG_LEVEL=INFO

# ---- Sign-in and sessions -------------------------------------------------
# Idle timeout in hours [12] and the hard cap on one sign-in in days [7].
# SESSION_HOURS=12
# SESSION_MAX_DAYS=7
# Failed password attempts before a 15-minute pause, per email+address [5].
# LOGIN_MAX_ATTEMPTS=5
# Proxies in front of the app that append to X-Forwarded-For [1 on Render, else 0].
# TRUSTED_PROXY_HOPS=1
# Keep the email + password form as a fallback until Microsoft sign-in is proven [true].
PASSWORD_LOGIN_ENABLED=true

# ---- Microsoft Entra ID single sign-on (README section 7) --------------
# From the Entra app registration. Leave blank to disable.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Single-tenant: the Directory (tenant) ID. Multi-tenant ("organizations") also REQUIRES
# SSO_ALLOWED_TENANTS; without it Microsoft sign-in stays off, because an email claim from
# an unknown tenant proves nothing.
MS_TENANT_ID=organizations
# SSO_ALLOWED_TENANTS=tenant-id-1,tenant-id-2
# Only these work-account domains may sign in.
SSO_ALLOWED_DOMAINS=washucarwash.com,washassociates.com,iconcarwash.com
# First Microsoft sign-in from an allowed domain creates an agent account [true].
SSO_AUTO_PROVISION=true

# ---- Google Business Profile ---------------------------------------------
# OAuth "Desktop app" client downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRETS_FILE=./client_secret.json
# Where the refresh token is stored after `python cli.py google-auth`.
GOOGLE_TOKEN_FILE=./google_token.json
# Alternative for hosted deploys: paste the contents of google_token.json here.
# GOOGLE_TOKEN_JSON=

# ---- Facebook Page recommendations (README section 3c) -----------------
# Long-lived System User token from Business Manager. Blank = Facebook off.
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_API_VERSION=v21.0

# ---- Listings to leave alone -------------------------------------------
# Google titles matching these are recorded but never synced or auto-mapped (the old
# Wash N' Roll profiles). Keep both apostrophe styles.
LISTING_EXCLUDE_PATTERNS=wash n' roll,wash n roll,wash n’ roll

# ---- Sync worker ----------------------------------------------------------
SYNC_INTERVAL_MINUTES=20
# Local hour after which the once-a-day full re-pull runs (catches removals) [3].
# FULL_SYNC_HOUR_LOCAL=3
# Consecutive complete full pulls that must miss a review before it counts as removed [2].
# REMOVAL_CONFIRM_PULLS=2

# ---- Morning report -------------------------------------------------------
# Local hour (0-23) the worker sends the report.
REPORT_HOUR_LOCAL=7
# Fallback recipients if none are stored in the report_recipients table.
# REPORT_RECIPIENTS=someone@washucarwash.com,other@washucarwash.com

# ---- Instant alerts --------------------------------------------------------
# Email the alerts list about new negative reviews [true] (removals and failing listings always).
# ALERT_NEGATIVES=true
# Failed syncs in a row before a listing is reported as failing [3].
# ALERT_FAIL_THRESHOLD=3

# ---- Review rules -----------------------------------------------------------
# Highest star rating that counts as negative [3].
# NEGATIVE_RATING_MAX=3
# Hours before an unanswered review is overdue [48].
# OVERDUE_HOURS=48
# Leave reviews reported to Google out of averages until Google decides [true].
# EXCLUDE_DISPUTED=true

# ---- Outbound email (Microsoft 365 SMTP AUTH shown) ------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=reviews@washucarwash.com
SMTP_PASSWORD=
SMTP_FROM=reviews@washucarwash.com

# ---- AI drafting and grouping (Claude) -------------------------------------
# Blank = AI off (no Draft with AI button, keyword grouping only).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Group negative reviews with Claude as they arrive [true].
# AI_CLASSIFY=true
# Phone number per brand that drafts may mention.
# BRAND_PHONES=WashU=(815) 205-3492;ICON=(615) 776-7837;WA=(615) 776-7837

# ---- Read-only API -----------------------------------------------------------
# Origins allowed to call /api/v1 from a browser [https://chris-stacks.washucarwash.com].
# API_CORS_ORIGINS=https://chris-stacks.washucarwash.com

# ---- Hosted demo only ---------------------------------------------------------
# Seeds placeholder data into an EMPTY SQLite database; replies never reach Google.
# Refused together with real Google/Facebook credentials or Postgres.
# DEMO_MODE=false
# DEMO_PASSWORD=          (required for a public demo)
# DEMO_MONTHS=18
