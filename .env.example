# ---- Database -------------------------------------------------------------
# Local dev: SQLite file. Production: Postgres, e.g.
#   postgresql+psycopg://user:pass@host:5432/reviews
DATABASE_URL=sqlite:///./review_manager.db

# ---- Web app --------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
TIMEZONE=America/Chicago

# ---- Google Business Profile ---------------------------------------------
# OAuth "Desktop app" client downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRETS_FILE=./client_secret.json
# Where the refresh token is stored after `python cli.py google-auth`.
GOOGLE_TOKEN_FILE=./google_token.json
# Alternative for hosted deploys: paste the contents of google_token.json here.
# GOOGLE_TOKEN_JSON=

# ---- Sync worker ----------------------------------------------------------
SYNC_INTERVAL_MINUTES=20

# ---- Morning report -------------------------------------------------------
# Local hour (0-23) the worker sends the report.
REPORT_HOUR_LOCAL=7
# Fallback recipients if none are stored in the report_recipients table.
# REPORT_RECIPIENTS=someone@washucarwash.com,other@washucarwash.com

# ---- Outbound email (Microsoft 365 SMTP AUTH shown) ------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=reviews@washucarwash.com
SMTP_PASSWORD=
SMTP_FROM=reviews@washucarwash.com

# ---- Listings to leave alone -------------------------------------------
# Google titles matching these are recorded but never synced or auto-mapped.
LISTING_EXCLUDE_PATTERNS=wash n' roll,wash n roll

# ---- Microsoft Entra ID single sign-on ---------------------------------
# From the Entra app registration (see README section 8). Leave blank to disable.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Single-tenant: paste the Directory (tenant) ID. Multi-tenant: leave "organizations".
MS_TENANT_ID=organizations
# Only these work-account domains may sign in.
SSO_ALLOWED_DOMAINS=washucarwash.com,washassociates.com,iconcarwash.com
# Optional hardening: comma-separated Entra tenant ids that are allowed.
# SSO_ALLOWED_TENANTS=
# First Microsoft sign-in from an allowed domain creates an agent account.
SSO_AUTO_PROVISION=true
# Keep the email + password form as a fallback until SSO is proven.
PASSWORD_LOGIN_ENABLED=true
